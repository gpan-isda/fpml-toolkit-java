<?xml version="1.0" encoding="UTF-8"?>
<!--
  conversion-delta.xsd
  Schema for FpML conversion delta profile files.

  A conversion delta profile describes optional overrides that are applied
  during or after a conversion between two FpML releases/views.

  Example usage:
    <conversion-delta from="4-1" to="4-2"
                      xmlns="http://www.handcoded.com/fpml/conversion-delta">
      <helper-values>
        <default key="referenceCurrency">USD</default>
        <default key="quantoCurrency1">EUR</default>
        <default key="quantoCurrency2">JPY</default>
        <default key="quantoCurrencyBasis">Currency2PerCurrency1</default>
      </helper-values>
      <enrich>
        <set-attribute xpath="//*[local-name()='dataDocument']/@fpmlVersion"
                       value="4-2"/>
        <remove-attribute xpath="//*[@schemaVersion]" attribute="schemaVersion"/>
      </enrich>
    </conversion-delta>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.handcoded.com/fpml/conversion-delta"
           xmlns="http://www.handcoded.com/fpml/conversion-delta"
           elementFormDefault="qualified">

  <!-- ============================================================
       Root element
       ============================================================ -->
  <xs:element name="conversion-delta">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="helper-values"       type="HelperValuesType"       minOccurs="0"/>
        <xs:element name="enrich"              type="EnrichType"             minOccurs="0"/>
        <xs:element name="rules"               type="RulesType"              minOccurs="0"/>
        <!--
          conditional-defaults: post-conversion default-value injection.
          Each <insert> entry is evaluated against the converted document and
          only applied when the target node is absent (or empty), subject to
          optional view / product-type scope guards.
          Entries are generated by XsdSchemaDiffer + DeltaProfileReviewer and
          must be reviewed/approved by a human before use.
        -->
        <xs:element name="conditional-defaults" type="ConditionalDefaultsType" minOccurs="0"/>
      </xs:sequence>
      <!-- Source release version, e.g. "4-1" -->
      <xs:attribute name="from" type="xs:string" use="required"/>
      <!-- Target release version, e.g. "4-2" -->
      <xs:attribute name="to"   type="xs:string" use="required"/>
      <!-- Optional source view (confirmation, reporting, etc.).  If absent, any view matches. -->
      <xs:attribute name="from-view" type="xs:string"/>
      <!-- Optional target view. If absent the source view is preserved. -->
      <xs:attribute name="to-view"   type="xs:string"/>
      <!--
        XSD namespace URI of the source FpML release (informational, emitted by XsdSchemaDiffer).
        E.g. "http://www.fpml.org/2023/FpML-5-12"
      -->
      <xs:attribute name="from-namespace" type="xs:string"/>
      <!--
        XSD namespace URI of the target FpML release.
        E.g. "http://www.fpml.org/2024/FpML-5-13"
      -->
      <xs:attribute name="to-namespace" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ============================================================
       Rules section
       Declares the named RuleSet instances (resolved via
       RuleSet.forName()) to use for inbound and outbound validation
       inside FpMLConversionPipeline.  Both children are optional;
       if absent the pipeline uses whatever rule sets were supplied
       programmatically via the Builder, or skips validation.
       ============================================================ -->
  <xs:complexType name="RulesType">
    <xs:sequence>
      <!-- Name of the RuleSet applied to the source document before conversion. -->
      <xs:element name="inbound"  type="RuleRefType" minOccurs="0"/>
      <!-- Name of the RuleSet applied to the converted document after enrichment. -->
      <xs:element name="outbound" type="RuleRefType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RuleRefType">
    <!-- RuleSet name as registered with RuleSet.forName(), e.g. "AllRules". -->
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ============================================================
       Helper-values section
       Provides default string values that the ConfigurableHelper
       returns when a structural conversion (R4_0→R4_1, R4_1→R4_2)
       requires caller-supplied data such as reference currencies.
       ============================================================ -->
  <xs:complexType name="HelperValuesType">
    <xs:sequence>
      <xs:element name="default" type="HelperDefaultType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="HelperDefaultType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <!--
          key is one of: referenceCurrency, quantoCurrency1, quantoCurrency2,
                          quantoCurrencyBasis
        -->
        <xs:attribute name="key" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ============================================================
       Enrich section
       Specifies post-conversion modifications applied to the
       converted document via PostConversionEnricher.
       ============================================================ -->
  <xs:complexType name="EnrichType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!--
        set-attribute: add or update an XML attribute on every element
        matched by the XPath expression.
          xpath     – XPath 1.0 expression evaluated against the document root
          attribute – local attribute name to set (optional; if absent, @xpath
                      must address an attribute node directly)
          value     – string value to assign
      -->
      <xs:element name="set-attribute">
        <xs:complexType>
          <xs:attribute name="xpath"     type="xs:string" use="required"/>
          <xs:attribute name="attribute" type="xs:string"/>
          <xs:attribute name="value"     type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
      <!--
        remove-attribute: remove an attribute from every matched element.
      -->
      <xs:element name="remove-attribute">
        <xs:complexType>
          <xs:attribute name="xpath"     type="xs:string" use="required"/>
          <xs:attribute name="attribute" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
      <!--
        set-text: replace the text content of every matched element.
      -->
      <xs:element name="set-text">
        <xs:complexType>
          <xs:attribute name="xpath"  type="xs:string" use="required"/>
          <xs:attribute name="value"  type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>


  <!-- ============================================================
       Conditional-defaults section
       Specifies post-conversion default-value injections that are
       applied only when the target node is absent (or its value is
       empty) in the converted document, subject to optional view
       and product-type scope guards.
       ============================================================ -->
  <xs:complexType name="ConditionalDefaultsType">
    <xs:sequence>
      <!--
        insert: inject a default value for a new or newly-required
        attribute/element introduced between the two versions.

        xpath            – XPath 1.0 expression.
                           • For attributes:  //*[local-name()='parent']/@attrName
                           • For element text: //*[local-name()='elemName']
        value            – The default string value to inject.
        only-if-absent   – When true (default) skip injection if the node already
                           exists with a non-empty value.
        view             – Optional FpML view scope (confirmation, reporting, …).
                           If absent the action applies to any view.
        product-type     – Optional product scope (e.g. "swap", "fxSingleLeg").
                           If absent the action applies to any product.
        constraint-type  – Informational tag: schema-required, schema-optional,
                           business-rule.
        note             – Free-text reviewer note.
      -->
      <xs:element name="insert" type="ConditionalDefaultType"
                  minOccurs="0" maxOccurs="unbounded"/>
      <!--
        rename: records a human-confirmed rename of an attribute or child element
        between the source and target XSD versions.  Confirmed by the reviewer
        via DeltaProfileReviewer when --detect-renames was used with XsdSchemaDiffer.

        from   – The old attribute/element local name (in the source version).
        to     – The new attribute/element local name (in the target version).
        xpath  – XPath 1.0 expression that selects the parent element(s) to act upon
                 (informational; used by runtime rename support when implemented).
        note   – Free-text reviewer note.

        NOTE: Runtime execution of rename actions requires PostConversionEnricher
              support (planned follow-on).  Until that is implemented the enricher
              logs and skips these entries without failing.
      -->
      <xs:element name="rename" type="RenameActionType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RenameActionType">
    <xs:attribute name="from"  type="xs:string" use="required"/>
    <xs:attribute name="to"    type="xs:string" use="required"/>
    <xs:attribute name="xpath" type="xs:string"/>
    <xs:attribute name="note"  type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="ConditionalDefaultType">
    <!--
      xpath             – XPath 1.0 expression selecting the target node.
      value             – Static default value to inject.  May be empty (or absent)
                          when prompt-at-runtime="true" is set — in that case the
                          conversion runtime will ask the operator for the value.
      only-if-absent    – Skip injection if the node already has a value (default true).
      prompt-at-runtime – When true and value is empty, FpMLConversionPipeline will
                          call the configured RuntimeValueProvider to obtain the value
                          at conversion time rather than silently skipping the entry.
                          Requires a RuntimeValueProvider to be configured on the
                          pipeline (e.g. ConsoleRuntimeValueProvider).
      view              – Optional FpML view scope.
      product-type      – Optional product-type scope.
      constraint-type   – Informational: schema-required, schema-optional, business-rule.
      note              – Free-text reviewer note.
    -->
    <xs:attribute name="xpath"             type="xs:string"  use="required"/>
    <xs:attribute name="value"             type="xs:string"  default=""/>
    <xs:attribute name="only-if-absent"    type="xs:boolean" default="true"/>
    <xs:attribute name="prompt-at-runtime" type="xs:boolean" default="false"/>
    <xs:attribute name="view"              type="xs:string"/>
    <xs:attribute name="product-type"      type="xs:string"/>
    <xs:attribute name="constraint-type"   type="xs:string"/>
    <xs:attribute name="note"              type="xs:string"/>
  </xs:complexType>

</xs:schema>

